---
// Home (SCREEN-1), design direction A "Estrutura à mostra" as refined in Claude Design (personal-brand
// docs/design/results/site-home/claude-design/home-full.webp, approved 2026-09-30): every section is a bordered
// cell with a mono caption naming the Perfect UI classes that build it and a numbered index. The "view as agent"
// switch sits in the header: on, every region shows its llms.txt reading (src/lib/llms.ts), with CSS only. All
// texts come from the data module; numbers are read at build.
import AgentText from "../components/AgentText.astro";
import Cell from "../components/Cell.astro";
import LabCard from "../components/LabCard.astro";
import McpDemo from "../components/McpDemo.astro";
import Portrait from "../components/Portrait.astro";
import PostCard from "../components/PostCard.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Showcase from "../components/Showcase.astro";
import Base from "../layouts/Base.astro";
import { lab, posts, products, profile, projects, readNpmCount, readWorkbenchCount, t, trajectory, type Lang } from "../data/index.ts";
import { PROJECT_STATUSES, PROJECT_TYPES } from "../data/schema.ts";
import { EMPTY, rowChips, stackValues } from "../lib/filters.ts";
import { formatNumber, formatPeriod, splitFigure, splitProducts, statusLabel } from "../lib/format.ts";
import { jsonLd } from "../lib/jsonld.ts";
import { llmsParts } from "../lib/llms.ts";
import { findClips } from "../lib/portrait/clips.ts";
import { siteUrl } from "../lib/site.ts";
import { resolveStats } from "../lib/stats.ts";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const site = siteUrl(Astro.site);
const npm = readNpmCount();
const workbench = readWorkbenchCount();
// The numbers strip in the design's order: size, downloads, hours, skills.
const ORDER = ["perfectui-size", "npm-downloads", "live-coding", "workbench-skills"];
const shownStats = resolveStats(lang, { npm, workbench }).sort((a, b) => ORDER.indexOf(a.id) - ORDER.indexOf(b.id));
const skillsLabel = shownStats.find((s) => s.id === "workbench-skills")?.label;
const agent = llmsParts(lang, { site, npm, workbench });
const productLine = (name: string) => agent.products.split("\n").find((l) => l.startsWith(`- [${name}]`)) ?? "";
const [perfectui, aiWorkbench] = products;
const latest = posts.slice(0, 4);
const label = profile.label[lang];
const pieces = splitProducts(label[2], products.map((p) => p.name));
const productBy = (name: string) => products.find((p) => p.name === name);
const npmPackage = perfectui?.npm ?? "@chrissgon/perfectui";
const installs = [
  { id: "npm", cmd: `npm i ${npmPackage}` },
  { id: "pnpm", cmd: `pnpm add ${npmPackage}` },
  { id: "yarn", cmd: `yarn add ${npmPackage}` },
  { id: "bun", cmd: `bun add ${npmPackage}` },
];
// The portrait's caption says "placeholder" until the encoded clips exist (scripts/encode-portrait.sh).
const portraitCaption = findClips().loop.length ? "portrait.mp4 · dots" : "portrait.mp4 · dots · placeholder";
const allowed = { type: [...PROJECT_TYPES], status: [...PROJECT_STATUSES], stack: stackValues(projects) };
const chips = rowChips(projects, EMPTY, PROJECT_STATUSES);
const index = (n: number, text: string) => `${String(n).padStart(2, "0")} · ${text}`;
const TAB_ON = "pui-soft pui-muted";
const TAB_OFF = "pui-outline pui-surface";
---

<Base lang={lang} path="/" title={profile.name} description={label.join(" · ")} jsonld={jsonLd(site)} agentScope>
  <Cell class="hero" tag="h1 · a.pui-btn.pui-solid.pui-theme" aria-labelledby="name">
    <div class="hero-text">
      <span class="index">{index(1, t(lang, "sectionIndex"))}</span>
      <h1 id="name">{profile.name}</h1>
      <div class="human hero-body">
        <p class="hero-label">
          {label[0]} · {label[1]} ·{" "}
          {pieces.map((p) => {
            if ("text" in p) return p.text;
            const product = productBy(p.product);
            return product ? (
              <a class:list={["pui-btn", product.id === "perfectui" ? "pui-solid pui-theme" : "pui-outline pui-surface"]} href={product.url}>{product.name}</a>
            ) : p.product;
          })}
        </p>
        <p class="hero-about">{profile.about[lang][0]}</p>
        <div class="install" data-tabs data-on={TAB_ON} data-off={TAB_OFF} data-copy-root>
          <div class="pui-group-row" role="tablist" aria-label={npmPackage}>
            {installs.map((x, i) => (
              <button
                type="button"
                role="tab"
                id={`install-tab-${x.id}`}
                aria-controls={`install-${x.id}`}
                aria-selected={i === 0 ? "true" : "false"}
                tabindex={i === 0 ? 0 : -1}
                class:list={["pui-btn mono", i === 0 ? TAB_ON : TAB_OFF]}
              >
                {x.id}
              </button>
            ))}
          </div>
          <div class="field install-field">
            {installs.map((x, i) => (
              <code role="tabpanel" id={`install-${x.id}`} aria-labelledby={`install-tab-${x.id}`} hidden={i > 0}>{x.cmd}</code>
            ))}
            <button type="button" class="pui-btn pui-outline pui-surface" data-copy="[role=tabpanel]:not([hidden])" data-copied={t(lang, "copied")} data-fallback={t(lang, "copyFallback")} hidden>{t(lang, "copy")}</button>
          </div>
          <span class="status" role="status" data-copy-status></span>
        </div>
      </div>
      <AgentText text={`${agent.head}\n${agent.about}`} />
    </div>
    <div class="hero-portrait">
      <Portrait alt={t(lang, "portraitAlt")} />
      <span class="caption portrait-caption" aria-hidden="true">{portraitCaption}</span>
    </div>
  </Cell>

  <Cell class="numbers-cell" aria-label={t(lang, "numbers")} reveal>
    <div class="human numbers">
      {shownStats.map((s) => {
        const [num, unit] = splitFigure(s.value);
        return (
          <div class="stat">
            <span class="stat-value"><span class="num" data-count={num}>{num}</span>{unit && <span class="unit">{unit}</span>}</span>
            <span class="stat-label">{s.label}</span>
          </div>
        );
      })}
    </div>
    <AgentText text={agent.numbers} />
  </Cell>

  {perfectui && aiWorkbench && (
    <Cell class="products" tag=".pui-card · .pui-card-header · .pui-chip" aria-label={t(lang, "products")} reveal>
      <div class="sec-head"><span class="index">{index(2, t(lang, "products"))}</span></div>
      <div class="products-grid">
        <div class="product">
          <h2 id="perfectui" class="h2">{perfectui.name}</h2>
          <p class="sec-lead human">{perfectui.summary[lang]}</p>
          <div class="human"><Showcase lang={lang} labelledby="perfectui" ids={["button", "switch", "card"]} selected="card" panel /></div>
          <AgentText text={`## ${t(lang, "products")}\n\n${productLine(perfectui.name)}`} />
        </div>
        <div class="product side">
          <h2 id="ai-workbench" class="h2">{aiWorkbench.name}</h2>
          <p class="sec-lead human">{aiWorkbench.summary[lang]}</p>
          {workbench && skillsLabel && (
            <div class="wb-stat human">
              <span class="num">{formatNumber(workbench.skills, lang)}</span>
              <span class="stat-label">{skillsLabel}</span>
            </div>
          )}
          <div class="human"><a class="pui-btn pui-outline pui-surface" href={aiWorkbench.url}>{aiWorkbench.name}</a></div>
          <AgentText text={productLine(aiWorkbench.name)} />
        </div>
      </div>
    </Cell>
  )}

  <Cell class="pad" id="projects" tag=".pui-chip · .pui-card · .pui-badge" aria-labelledby="projects-title" reveal data-filters data-allowed={JSON.stringify(allowed)}>
    <span class="index">{index(3, t(lang, "navProjects"))}</span>
    <div class="sec-row">
      <h2 id="projects-title" class="h2">{t(lang, "projectsTitle")}</h2>
      <div class="chip-row js-only human" role="group" aria-labelledby="projects-title">
        <button type="button" class="pui-chip pui-solid pui-inverse" aria-pressed="true" data-all>{t(lang, "filterAll")} <span class="chip-n">{projects.length}</span></button>
        {chips.map((c) => (
          <button type="button" class="pui-chip pui-outline pui-surface" aria-pressed="false" data-group={c.group} data-value={c.value}>
            {c.group === "status" ? statusLabel(c.value as (typeof PROJECT_STATUSES)[number], lang) : c.value} <span class="chip-n" data-chip-count>{c.count}</span>
          </button>
        ))}
      </div>
    </div>
    <div class="human">
      <div class="pui-card empty" data-empty hidden>
        <div class="pui-card-content">
          <span class="empty-text">{t(lang, "noProjectMatch")}</span>
          <div><button type="button" class="pui-chip pui-outline pui-surface" aria-pressed="false" data-all>{t(lang, "filterAll")} <span class="chip-n">{projects.length}</span></button></div>
        </div>
      </div>
      <div class="grid3">
        {projects.map((p) => (
          <div class="card-slot" data-types={p.types.join(" ")} data-status={p.status} data-stack={JSON.stringify(p.stack)} style={`view-transition-name: project-${p.id}`}>
            <ProjectCard project={p} lang={lang} />
          </div>
        ))}
      </div>
    </div>
    <AgentText text={agent.projects} />
  </Cell>

  <Cell class="pad" tag="a.pui-card · .pui-badge.pui-outline" aria-labelledby="writing-title" reveal>
    <span class="index">{index(4, t(lang, "navWriting"))}</span>
    <h2 id="writing-title" class="h2 sec-title">{t(lang, "writingTitle")}</h2>
    <div class="human grid4 posts">
      {latest.map((p) => <PostCard post={p} lang={lang} date={false} compact />)}
    </div>
    <AgentText text={agent.writing} />
  </Cell>

  <Cell class="split traj-cell" id={lang === "en" ? "trajectory" : "trajetoria"} aria-labelledby="trajectory-title" reveal>
    <div class="pad traj">
      <span class="tag" aria-hidden="true">.pui-timeline</span>
      <h2 id="trajectory-title" class="h2 sec-title">{t(lang, "trajectory")}</h2>
      <ol class="human pui-timeline timeline">
        {trajectory.entries.map((e, i) => (
          <li class="pui-checkpoint" style={`--i: ${i}`}>
            <i class:list={["pui-checkpoint-icon", e.to === null ? "pui-solid pui-inverse" : "pui-outline pui-surface"]} aria-hidden="true"></i>
            <div class="stack-4">
              <strong><span class="mono">{formatPeriod(e, lang)}</span>{e.role && <> · {e.role}</>}</strong>
              <p class="muted">{e.focus[lang]}</p>
            </div>
          </li>
        ))}
      </ol>
      <AgentText text={agent.trajectory} />
    </div>
    <div class="pad side proofs human">
      <span class="tag" aria-hidden="true">ul.pui-list</span>
      {trajectory.education && (
        <div class="education">
          <h3 class="lbl">{t(lang, "education")}</h3>
          <p>{trajectory.education[lang]}</p>
        </div>
      )}
      <h3 class="lbl">{t(lang, "proofs")}</h3>
      <ul class="pui-list">
        {trajectory.proofs.map((p) => <li class="pui-list-item pui-outline pui-surface mono">{p[lang]}</li>)}
      </ul>
    </div>
  </Cell>

  <Cell class="lab-cell" id="lab" tag="a.pui-btn.pui-outline.pui-surface" aria-labelledby="lab-title" reveal>
    <div class="sec-head"><h2 id="lab-title" class="index">{index(5, t(lang, "navLab"))}</h2></div>
    <div class="human lab-row">
      {lab.map((x) => <div class="lab-col"><LabCard item={x} lang={lang} /></div>)}
    </div>
    <AgentText text={agent.lab} />
  </Cell>

  <Cell class="agents-cell" id="for-agents" tag=".pui-group-row · input.pui-input · .pui-btn.pui-link" aria-labelledby="agents-title" reveal>
    <div class="agents-head">
      <span class="index">{index(6, t(lang, "navAgents"))}</span>
      <h2 id="agents-title" class="h2">{t(lang, "connectAgent")}</h2>
    </div>
    <div class="human agents-demo"><McpDemo lang={lang} variant="row" /></div>
    <AgentText text={agent.agents} />
  </Cell>
</Base>

<script>
  import "../scripts/filters.ts";
</script>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 504px;
    min-height: 676px;
  }
  .hero-text {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 80px var(--gutter) 56px;
    border-right: 1px solid var(--pui-border);
  }
  .hero-text .index {
    margin-bottom: 36px;
  }
  .hero h1 {
    max-width: 560px;
    font-size: 60px;
    line-height: 1.04;
  }
  .hero-body {
    display: flex;
    flex-direction: column;
  }
  .hero-label {
    margin-top: 36px;
    font-size: 17px;
    line-height: 1.75;
    color: var(--pui-text-muted);
  }
  .hero-label .pui-btn {
    --pui-font-size: 0.8125rem;
    padding: 5px 12px;
    margin-inline: 2px;
    vertical-align: 1px;
  }
  .hero-about {
    max-width: 620px;
    margin-top: 28px;
    font-size: 17px;
    line-height: 1.65;
  }
  .install {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 560px;
    margin-top: 36px;
  }
  .install [role="tablist"] {
    align-self: flex-start;
  }
  .install [role="tab"] {
    --pui-font-size: 0.75rem;
    padding: 6px 14px;
  }
  .install [role="tab"].pui-outline {
    color: var(--pui-text);
  }
  .install-field {
    padding: 12px 12px 12px 18px;
    background: var(--pui-bg-muted);
  }
  .install-field code {
    font-size: 13px;
  }
  .install .status:empty {
    display: none;
  }
  .hero-portrait {
    position: relative;
    overflow: clip;
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .hero-portrait > :global(.portrait-band) {
    width: 100%;
  }
  .portrait-caption {
    position: absolute;
    left: 16px;
    bottom: 12px;
    z-index: 3;
    padding: 2px 6px;
    background: var(--pui-bg);
  }

  .numbers {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  .stat {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
    padding: 36px 32px 34px;
  }
  .stat + .stat {
    border-left: 1px solid var(--pui-border);
  }
  .stat-value {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }
  .num {
    font-size: 52px;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .unit {
    font-size: 18px;
    font-weight: 600;
    color: var(--pui-text-muted);
  }
  .stat-label {
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.5;
    color: var(--pui-text-muted);
  }

  .sec-head {
    padding: 44px var(--gutter) 0;
  }
  .sec-title {
    margin-bottom: 28px;
  }
  .sec-lead {
    max-width: 560px;
    font-size: 16px;
    line-height: 1.65;
    color: var(--pui-text-muted);
  }
  .products-grid {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
  }
  .product {
    display: flex;
    flex-direction: column;
    gap: 20px;
    min-width: 0;
    padding: 4px var(--gutter) 56px;
  }
  .product.side {
    position: relative;
    padding-inline: 48px var(--gutter);
    border-left: 1px solid var(--pui-border);
  }
  .product > .human:has(.showcase-panel) {
    margin-top: 8px;
    max-width: 660px;
  }
  .wb-stat {
    display: flex;
    align-items: baseline;
    gap: 16px;
    padding: 20px 0;
    border-block: 1px solid var(--pui-border);
  }

  .sec-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
    margin-bottom: 28px;
  }
  .card-slot {
    display: flex;
  }
  .card-slot > :global(.pui-card) {
    flex: 1;
  }
  .card-slot[hidden] {
    display: none;
  }
  .empty {
    max-width: 560px;
    margin-bottom: 24px;
  }
  .empty[hidden] {
    display: none;
  }
  .empty-text {
    font-size: 18px;
    font-weight: 600;
  }
  :global(::view-transition-group(*)) {
    animation-duration: 0.25s;
  }
  .posts {
    gap: 16px;
  }

  .traj {
    position: relative;
    flex: 1;
  }
  .traj .h2 {
    margin-top: 8px;
  }
  .timeline {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .timeline strong {
    font-weight: 600;
  }
  .timeline .mono {
    font-weight: 600;
  }
  .timeline p {
    line-height: 1.5;
  }
  .stack-4 {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .proofs {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 600px;
    flex: none;
    padding-inline: 48px var(--gutter);
  }
  .proofs .lbl {
    margin-top: 8px;
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.08em;
  }
  .education {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-bottom: 24px;
    margin-bottom: 8px;
    border-bottom: 1px solid var(--pui-border);
    font-size: 16px;
  }
  .proofs ul {
    display: flex;
    flex-direction: column;
    gap: 8px;
    list-style: none;
  }
  .proofs li {
    font-size: 12px;
    line-height: 1.5;
  }

  .lab-cell .sec-head {
    padding-bottom: 20px;
    border-bottom: 1px solid var(--pui-border);
  }
  .lab-cell .index {
    margin: 0;
  }
  .lab-row {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
  }
  .lab-col {
    min-width: 0;
    padding: 24px 24px 20px;
  }
  .lab-col + .lab-col {
    border-left: 1px solid var(--pui-border);
  }

  .agents-cell {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 560px;
    align-items: start;
    gap: 16px 48px;
    padding: 56px var(--gutter);
  }
  .agents-head .index {
    margin-bottom: 12px;
  }
  .agents-cell > :global(.agent-text) {
    grid-column: 1 / -1;
  }
  .numbers-cell > :global(.agent-text),
  .lab-cell > :global(.agent-text),
  .product > :global(.agent-text) {
    padding: 32px var(--gutter);
  }
  .product > :global(.agent-text) {
    padding: 0;
  }

  /* The timeline's dots light up in sequence when the section enters (400 ms in all). */
  :global(html.js) .reveal .timeline .pui-checkpoint-icon {
    transition: background-color 0.15s, border-color 0.15s;
    transition-delay: calc(var(--i) * 60ms);
  }
  :global(html.js) .reveal:not(.in) .timeline .pui-checkpoint-icon {
    border-color: var(--pui-bg-emphasis);
    background-color: var(--pui-bg);
  }

  @media (max-width: 1279px) {
    .lab-row {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .lab-col {
      border-bottom: 1px solid var(--pui-border);
    }
    .lab-col:nth-child(3n + 1) {
      border-left: none;
    }
    .proofs {
      width: 480px;
    }
  }
  @media (max-width: 1023px) {
    .hero {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
    .hero h1 {
      font-size: 48px;
    }
    .numbers {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .stat:nth-child(3) {
      border-left: none;
    }
    .stat:nth-child(n + 3) {
      border-top: 1px solid var(--pui-border);
    }
    .products-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .product.side {
      padding-inline: var(--gutter);
      padding-top: 40px;
      border-left: none;
      border-top: 1px solid var(--pui-border);
    }
    .proofs {
      width: 360px;
    }
    .agents-cell {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 767px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      min-height: 0;
    }
    .hero-text {
      padding: 44px var(--gutter) 32px;
      border-right: none;
      border-bottom: 1px solid var(--pui-border);
    }
    .hero-text .index {
      margin-bottom: 20px;
    }
    .hero h1 {
      font-size: 40px;
      line-height: 1.05;
    }
    .hero-label {
      margin-top: 20px;
      font-size: 15px;
    }
    .hero-about {
      margin-top: 20px;
      font-size: 16px;
    }
    .install {
      margin-top: 24px;
    }
    .hero-portrait {
      height: 460px;
    }
    .stat {
      padding: 24px var(--gutter);
      gap: 10px;
    }
    .num {
      font-size: 34px;
    }
    .unit {
      font-size: 14px;
    }
    .sec-head {
      padding-top: 40px;
    }
    .product,
    .product.side {
      padding: 4px var(--gutter) 40px;
    }
    .product.side {
      padding-top: 32px;
    }
    .sec-row {
      margin-bottom: 20px;
    }
    .sec-row .chip-row {
      flex-wrap: nowrap;
      max-width: 100%;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .proofs {
      width: auto;
      padding-inline: var(--gutter);
    }
    .lab-row {
      grid-template-columns: minmax(0, 1fr);
    }
    .lab-col,
    .lab-col + .lab-col {
      padding: 20px var(--gutter);
      border-left: none;
    }
    .agents-cell {
      padding: 40px var(--gutter);
    }
  }
</style>
