---
// Writing (SCREEN-3), design direction A: the title cell with the post count, then a sheet of cells, one per
// post, newest first, each tagged with its date; the post's own cover is the largest element of its card; the
// whole card links to LinkedIn. The profile link closes the list. Empty: the title and the profile link only.
// "view as agent" (the header's switch): the list's cell shows the writing part of llms.txt; the count, the posts
// and the profile link are human.
import AgentText from "../components/AgentText.astro";
import Cell from "../components/Cell.astro";
import PostCard from "../components/PostCard.astro";
import Base from "../layouts/Base.astro";
import { posts, profile, readNpmCount, readWorkbenchCount, t, type Lang } from "../data/index.ts";
import { formatDate } from "../lib/format.ts";
import { llmsParts } from "../lib/llms.ts";
import { siteUrl } from "../lib/site.ts";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const agent = llmsParts(lang, { site: siteUrl(Astro.site), npm: readNpmCount(), workbench: readWorkbenchCount() });
const linkedin = profile.profiles.find((p) => p.network === "LinkedIn");
// Four columns from 1024 px, three from 768 px, two below.
const POST_SIZES = "(min-width: 1024px) 288px, (min-width: 768px) calc(33vw - 48px), calc(50vw - 32px)";
---

<Base lang={lang} path="/writing" title={`${t(lang, "navWriting")} · ${profile.name}`} description={t(lang, "homeDescription")}>
  <Cell class="page-title" tag="h1">
    <h1>{t(lang, "navWriting")}</h1>
    <span class="count human">{posts.length}</span>
  </Cell>

  {posts.length === 0 ? (
    <Cell class="pad"><p class="human">{t(lang, "noPosts")}</p><AgentText text={agent.writing} /></Cell>
  ) : (
    <section class="cell sheet-cell" aria-labelledby="writing-list">
      <h2 id="writing-list" class="sr-only">{t(lang, "navWriting")}</h2>
      <div class="cells sheet human">
        {posts.map((p, i) => (
          <div class="post reveal" style={`--i: ${i % 4}`}>
            <span class="tag" aria-hidden="true">{formatDate(p.date, lang)}</span>
            <PostCard post={p} lang={lang} date={false} eager={i === 0} sizes={POST_SIZES} />
          </div>
        ))}
      </div>
      <AgentText text={agent.writing} class="pad" />
    </section>
  )}

  {linkedin && (
    <Cell class="pad profile-link human">
      <a class="pui-btn pui-outline pui-surface mono" href={linkedin.url} rel="me">{linkedin.network} {linkedin.handle}</a>
    </Cell>
  )}
</Base>

<style>
  /* The sheet's cell draws the bottom line under the last row, so a row with empty slots stays closed (.cells). */
  .sheet {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  .post {
    position: relative;
    display: flex;
    padding: 40px 20px 24px;
    transition-delay: calc(var(--i) * 60ms);
  }
  .post > :global(.post-card) {
    flex: 1;
  }
  .profile-link {
    padding-block: 40px;
  }
  @media (max-width: 1023px) {
    .sheet {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 767px) {
    .sheet {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .post {
      padding: 36px var(--gutter) 20px;
    }
    .post :global(.title) {
      font-size: 14px;
    }
  }
</style>
