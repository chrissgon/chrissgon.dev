---
// Writing (SCREEN-3), design direction A: the title cell with the post count, then a sheet of cells, one per
// post, newest first, each tagged with its date; the post's own cover is the largest element of its card; the
// whole card links to LinkedIn. The profile link closes the list. Empty: the title and the profile link only.
import Cell from "../components/Cell.astro";
import PostCard from "../components/PostCard.astro";
import Base from "../layouts/Base.astro";
import { posts, profile, t, type Lang } from "../data/index.ts";
import { formatDate } from "../lib/format.ts";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const linkedin = profile.profiles.find((p) => p.network === "LinkedIn");
// Four columns from 1024 px, three from 768 px, two below.
const POST_SIZES = "(min-width: 1024px) 288px, (min-width: 768px) calc(33vw - 48px), calc(50vw - 32px)";
---

<Base lang={lang} path="/writing" title={`${t(lang, "navWriting")} · ${profile.name}`} description={t(lang, "homeDescription")}>
  <Cell class="page-title" tag="h1">
    <h1>{t(lang, "navWriting")}</h1>
    <span class="count">{posts.length}</span>
  </Cell>

  {posts.length === 0 ? (
    <Cell class="pad"><p>{t(lang, "noPosts")}</p></Cell>
  ) : (
    <section class="sheet" aria-labelledby="writing-list">
      <h2 id="writing-list" class="sr-only">{t(lang, "navWriting")}</h2>
      {posts.map((p, i) => (
        <div class="post reveal" style={`--i: ${i % 4}`}>
          <span class="tag" aria-hidden="true">{formatDate(p.date, lang)}</span>
          <PostCard post={p} lang={lang} date={false} eager={i === 0} sizes={POST_SIZES} />
        </div>
      ))}
    </section>
  )}

  {linkedin && (
    <Cell class="pad profile-link">
      <a class="pui-btn pui-outline pui-surface mono" href={linkedin.url} rel="me">{linkedin.network} {linkedin.handle}</a>
    </Cell>
  )}
</Base>

<style>
  .sheet {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  .post {
    position: relative;
    display: flex;
    padding: 40px 20px 24px;
    border-right: 1px solid var(--pui-border);
    border-bottom: 1px solid var(--pui-border);
    transition-delay: calc(var(--i) * 60ms);
  }
  .post:nth-child(4n + 1) {
    border-right: none;
  }
  .post > :global(.post-card) {
    flex: 1;
  }
  .profile-link {
    padding-block: 40px;
  }
  /* The first child of .sheet is the hidden h2, so the last post of a row of n is child n·k + 1. */
  @media (max-width: 1023px) {
    .sheet {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .post:nth-child(4n + 1) {
      border-right: 1px solid var(--pui-border);
    }
    .post:nth-child(3n + 1) {
      border-right: none;
    }
  }
  @media (max-width: 767px) {
    .sheet {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .post,
    .post:nth-child(4n + 1),
    .post:nth-child(3n + 1) {
      border-right: 1px solid var(--pui-border);
      padding: 36px var(--gutter) 20px;
    }
    .post:nth-child(2n + 1) {
      border-right: none;
    }
    .post :global(.title) {
      font-size: 14px;
    }
  }
</style>
