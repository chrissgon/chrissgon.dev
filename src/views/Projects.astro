---
// Projects (SCREEN-2), design direction A: the title cell with the result count, the filter bar as a visible
// pui-group-row of pui-chip buttons with counts (type, status, stack; one chip per group; groups combine; the
// state in the URL query), and the ten projects as pui-card cells, ready first. Without JavaScript every card
// shows and the filter bar stays hidden.
import Cell from "../components/Cell.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Base from "../layouts/Base.astro";
import { PROJECT_STATUSES, PROJECT_TYPES } from "../data/schema.ts";
import { profile, projects, t, type Lang } from "../data/index.ts";
import { chipCount, EMPTY, stackValues, type Group } from "../lib/filters.ts";
import { statusLabel, typeLabel } from "../lib/format.ts";
import { jsonLd } from "../lib/jsonld.ts";
import { siteUrl } from "../lib/site.ts";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const ordered = [...projects].sort((a, b) => PROJECT_STATUSES.indexOf(a.status) - PROJECT_STATUSES.indexOf(b.status));
const stacks = stackValues(projects);
const groups: { group: Group; label: string; chips: { value: string; label: string; mono?: boolean }[] }[] = [
  { group: "type", label: t(lang, "byType"), chips: PROJECT_TYPES.map((v) => ({ value: v, label: typeLabel(v, lang) })) },
  { group: "status", label: t(lang, "byStatus"), chips: PROJECT_STATUSES.map((v) => ({ value: v, label: statusLabel(v, lang) })) },
  { group: "stack", label: t(lang, "byStack"), chips: stacks.map((v) => ({ value: v, label: v, mono: true })) },
];
const allowed = { type: [...PROJECT_TYPES], status: [...PROJECT_STATUSES], stack: stacks };
const OFF = "pui-chip pui-outline pui-surface";
const ON = "pui-chip pui-solid pui-inverse";
---

<Base lang={lang} path="/projects" title={`${t(lang, "navProjects")} · ${profile.name}`} description={t(lang, "homeDescription")} jsonld={jsonLd(siteUrl(Astro.site))}>
  <Cell class="page-title" tag="h1 + [role=status]">
    <h1>{t(lang, "navProjects")}</h1>
    <span class="count" role="status" data-result-count>{projects.length}</span>
  </Cell>

  <Cell class="pad filters js-only" tag=".pui-group-row > button.pui-chip[aria-pressed]" aria-label={`${t(lang, "byType")}, ${t(lang, "byStatus")}, ${t(lang, "byStack")}`} data-filters data-allowed={JSON.stringify(allowed)}>
    <div class="filter-grid">
      <span></span>
      <div class="chip-row">
        <button type="button" class={ON} aria-pressed="true" data-all>{t(lang, "filterAll")} <span class="pui-badge pui-soft pui-muted pui-rounded-full mono">{projects.length}</span></button>
      </div>
      {groups.map((g) => (
        <>
          <span class="lbl" id={`group-${g.group}`}>{g.label}</span>
          <div class="pui-group-row chip-row" role="group" aria-labelledby={`group-${g.group}`}>
            {g.chips.map((c) => (
              <button type="button" class:list={[OFF, { mono: c.mono }]} aria-pressed="false" data-group={g.group} data-value={c.value}>
                {c.label} <span class="pui-badge pui-soft pui-muted pui-rounded-full mono" data-chip-count>{chipCount(projects, EMPTY, g.group, c.value)}</span>
              </button>
            ))}
          </div>
        </>
      ))}
    </div>
  </Cell>

  <Cell class="pad results" tag={`article.pui-card × ${projects.length}`}>
    <div class="pui-card empty" data-empty hidden>
      <div class="pui-card-content">
        <span class="empty-text">{t(lang, "noProjectMatch")}</span>
        <div><button type="button" class={OFF} aria-pressed="false" data-all>{t(lang, "filterAll")} <span class="pui-badge pui-soft pui-muted pui-rounded-full mono">{projects.length}</span></button></div>
      </div>
    </div>
    <div class="grid3">
      {ordered.map((p) => (
        <div class="card-slot" data-types={p.types.join(" ")} data-status={p.status} data-stack={JSON.stringify(p.stack)} style={`view-transition-name: project-${p.id}`}>
          <ProjectCard project={p} lang={lang} />
        </div>
      ))}
    </div>
  </Cell>
</Base>

<script>
  import { chipCount, isEmpty, parseQuery, toggle, toQuery, EMPTY, matches, type Allowed, type FilterState, type Group } from "../lib/filters.ts";

  const bar = document.querySelector<HTMLElement>("[data-filters]");
  const slots = [...document.querySelectorAll<HTMLElement>(".card-slot")];
  const items = slots.map((el) => ({
    el,
    types: (el.dataset.types ?? "").split(" "),
    status: el.dataset.status ?? "",
    stack: JSON.parse(el.dataset.stack ?? "[]") as string[],
  }));
  const count = document.querySelector<HTMLElement>("[data-result-count]");
  const empty = document.querySelector<HTMLElement>("[data-empty]");
  const tag = document.querySelector<HTMLElement>(".results > .tag");
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const ON = ["pui-solid", "pui-inverse"];
  const OFF = ["pui-outline", "pui-surface"];
  const press = (b: HTMLElement, on: boolean) => {
    b.setAttribute("aria-pressed", String(on));
    b.classList.remove(...(on ? OFF : ON));
    b.classList.add(...(on ? ON : OFF));
  };

  if (bar) {
    const allowed = JSON.parse(bar.dataset.allowed ?? "{}") as Allowed;
    let state: FilterState = parseQuery(location.search, allowed);

    const render = () => {
      let shown = 0;
      for (const it of items) {
        const on = matches(it, state);
        it.el.hidden = !on;
        if (on) shown++;
      }
      if (count) count.textContent = String(shown);
      if (tag) tag.textContent = tag.textContent!.replace(/\d+$/, String(shown));
      if (empty) empty.hidden = shown > 0;
      for (const b of document.querySelectorAll<HTMLElement>("[data-group]")) {
        const g = b.dataset.group as Group, v = b.dataset.value ?? "";
        press(b, state[g] === v);
        const n = b.querySelector("[data-chip-count]");
        if (n) n.textContent = String(chipCount(items, state, g, v));
      }
      for (const b of bar.querySelectorAll<HTMLElement>("[data-all]")) press(b, isEmpty(state));
      const query = toQuery(state);
      history.replaceState(null, "", location.pathname + query + location.hash);
      for (const a of document.querySelectorAll<HTMLAnchorElement>("[data-lang-link]")) {
        a.search = query;
      }
    };
    // Toggling a chip reorders the grid within 300 ms (a view transition), at once with reduced motion.
    const apply = (next: FilterState) => {
      state = next;
      const doc = document as Document & { startViewTransition?: (cb: () => void) => unknown };
      if (!reduced && doc.startViewTransition) doc.startViewTransition(render);
      else render();
    };
    document.addEventListener("click", (e) => {
      const b = (e.target as Element).closest<HTMLElement>("[data-group], [data-all]");
      if (!b) return;
      apply(b.hasAttribute("data-all") ? { ...EMPTY } : toggle(state, b.dataset.group as Group, b.dataset.value ?? ""));
    });
    render();
  }
</script>

<style>
  .filter-grid {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    gap: 16px 20px;
    align-items: center;
  }
  .chip-row {
    max-width: 100%;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .chip-row .pui-chip {
    cursor: pointer;
  }
  .results .grid3 {
    align-items: stretch;
  }
  .card-slot {
    display: flex;
  }
  .card-slot > :global(.pui-card) {
    flex: 1;
  }
  .card-slot[hidden] {
    display: none;
  }
  .empty {
    max-width: 560px;
  }
  .empty[hidden] {
    display: none;
  }
  .empty-text {
    font-size: 18px;
    font-weight: 600;
  }
  :global(html:not(.js)) .js-only {
    display: none;
  }
  :global(::view-transition-group(*)) {
    animation-duration: 0.25s;
  }
  @media (max-width: 767px) {
    .filter-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 8px;
    }
    .filter-grid > .lbl {
      margin-top: 8px;
    }
    .chip-row {
      flex-wrap: nowrap;
      white-space: nowrap;
    }
  }
</style>
