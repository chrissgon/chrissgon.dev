---
// Projects (SCREEN-2), design direction A: the title cell with the result count, the filter bar as a visible
// pui-group-row of pui-chip buttons with counts (type, status, stack; one chip per group; groups combine; the
// state in the URL query), and the ten projects as pui-card cells, ready first. Without JavaScript every card
// shows and the filter bar stays hidden. "view as agent" (the header's switch): the results cell shows the
// projects part of llms.txt, every project whatever the filters; the count and the filter bar are human UI.
import AgentText from "../components/AgentText.astro";
import Cell from "../components/Cell.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Base from "../layouts/Base.astro";
import { PROJECT_STATUSES, PROJECT_TYPES } from "../data/schema.ts";
import { profile, projects, readNpmCount, readWorkbenchCount, t, type Lang } from "../data/index.ts";
import { chipCount, EMPTY, stackValues, type Group } from "../lib/filters.ts";
import { statusLabel, typeLabel } from "../lib/format.ts";
import { jsonLd } from "../lib/jsonld.ts";
import { llmsParts } from "../lib/llms.ts";
import { siteUrl } from "../lib/site.ts";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const site = siteUrl(Astro.site);
const agent = llmsParts(lang, { site, npm: readNpmCount(), workbench: readWorkbenchCount() });
const ordered = [...projects].sort((a, b) => PROJECT_STATUSES.indexOf(a.status) - PROJECT_STATUSES.indexOf(b.status));
const stacks = stackValues(projects);
const groups: { group: Group; label: string; chips: { value: string; label: string; mono?: boolean }[] }[] = [
  { group: "type", label: t(lang, "byType"), chips: PROJECT_TYPES.map((v) => ({ value: v, label: typeLabel(v, lang) })) },
  { group: "status", label: t(lang, "byStatus"), chips: PROJECT_STATUSES.map((v) => ({ value: v, label: statusLabel(v, lang) })) },
  { group: "stack", label: t(lang, "byStack"), chips: stacks.map((v) => ({ value: v, label: v, mono: true })) },
];
const allowed = { type: [...PROJECT_TYPES], status: [...PROJECT_STATUSES], stack: stacks };
const OFF = "pui-chip pui-outline pui-surface";
const ON = "pui-chip pui-solid pui-inverse";
---

<Base lang={lang} path="/projects" title={`${t(lang, "navProjects")} · ${profile.name}`} description={t(lang, "homeDescription")} jsonld={jsonLd(site)}>
  <Cell class="page-title" tag="h1 + [role=status]">
    <h1>{t(lang, "navProjects")}</h1>
    <span class="count human" role="status" data-result-count>{projects.length}</span>
  </Cell>

  <Cell class="pad filters js-only human" tag=".pui-chip[aria-pressed]" aria-label={`${t(lang, "byType")}, ${t(lang, "byStatus")}, ${t(lang, "byStack")}`} data-filters data-allowed={JSON.stringify(allowed)}>
    <div class="filter-grid">
      <span></span>
      <div class="chip-row">
        <button type="button" class={ON} aria-pressed="true" data-all>{t(lang, "filterAll")} <span class="chip-n">{projects.length}</span></button>
      </div>
      {groups.map((g) => (
        <>
          <span class="lbl" id={`group-${g.group}`}>{g.label}</span>
          <div class="chip-row" role="group" aria-labelledby={`group-${g.group}`}>
            {g.chips.map((c) => (
              <button type="button" class:list={[OFF, { mono: c.mono }]} aria-pressed="false" data-group={g.group} data-value={c.value}>
                {c.label} <span class="chip-n" data-chip-count>{chipCount(projects, EMPTY, g.group, c.value)}</span>
              </button>
            ))}
          </div>
        </>
      ))}
    </div>
  </Cell>

  <Cell class="pad results" tag={`.pui-card · .pui-badge × ${projects.length}`} countTag>
    <h2 class="sr-only">{t(lang, "projectsTitle")}</h2>
    <div class="human">
      <div class="pui-card empty" data-empty hidden>
        <div class="pui-card-content">
          <span class="empty-text">{t(lang, "noProjectMatch")}</span>
          <div><button type="button" class={OFF} aria-pressed="false" data-all>{t(lang, "filterAll")} <span class="chip-n">{projects.length}</span></button></div>
        </div>
      </div>
      <div class="grid3">
        {ordered.map((p) => (
          <div class="card-slot" data-types={p.types.join(" ")} data-status={p.status} data-stack={JSON.stringify(p.stack)} style={`view-transition-name: project-${p.id}`}>
            <ProjectCard project={p} lang={lang} />
          </div>
        ))}
      </div>
    </div>
    <AgentText text={agent.projects} />
  </Cell>
</Base>

<script>
  import "../scripts/filters.ts";
</script>

<style>
  .filter-grid {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    gap: 16px 20px;
    align-items: center;
  }
  .chip-row {
    max-width: 100%;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .results .grid3 {
    align-items: stretch;
  }
  .card-slot {
    display: flex;
  }
  .card-slot > :global(.pui-card) {
    flex: 1;
  }
  .card-slot[hidden] {
    display: none;
  }
  .empty {
    max-width: 560px;
  }
  .empty[hidden] {
    display: none;
  }
  .empty-text {
    font-size: 18px;
    font-weight: 600;
  }
  :global(html:not(.js)) .js-only {
    display: none;
  }
  :global(::view-transition-group(*)) {
    animation-duration: 0.25s;
  }
  @media (max-width: 767px) {
    .filter-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 8px;
    }
    .filter-grid > .lbl {
      margin-top: 8px;
    }
    .chip-row {
      flex-wrap: nowrap;
      white-space: nowrap;
    }
  }
</style>
