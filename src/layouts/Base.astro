---
// Base layout (design: "Layout base"): head, Perfect UI, canonical, hreflang, JSON-LD, skip link,
// navigation and language switch. Dark only (decision of 2026-09-29). No custom styling yet: the visual
// design comes later; the only rules here apply the self-hosted fonts (ADR-0006).
// Preloads: Inter 400 (body text) and 800 (the h1, the LCP) are on the first screen; Inter 600 and
// JetBrains Mono are not, so they load only when a rule uses them.
import "@chrissgon/perfectui/perfectui.css";
import { Font } from "astro:assets";
import { profile, t, type Lang } from "../data/index.ts";
import { LOCALE, localePath } from "../lib/format.ts";
import { assertPublishable, serializeJsonLd, type jsonLd as JsonLdBuilder } from "../lib/jsonld.ts";
import { siteUrl } from "../lib/site.ts";

interface Props {
  lang: Lang;
  /** The page's path without the locale prefix: "/", "/projects", ... */
  path: string;
  title: string;
  description: string;
  jsonld?: ReturnType<typeof JsonLdBuilder>;
}

const { lang, path, title, description, jsonld } = Astro.props;
const site = siteUrl(Astro.site);
const other: Lang = lang === "en" ? "pt" : "en";
const href = (l: Lang, p: string) => `${site}${localePath(l, p)}`;
const nav = [
  { key: "navProjects", path: "/projects" },
  { key: "navWriting", path: "/writing" },
  { key: "navLab", path: "/lab" },
] as const;
---

<!doctype html>
<html lang={LOCALE[lang]} data-pui-mode="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <Font cssVariable="--font-sans" preload={[{ weight: "400" }, { weight: "800" }]} />
    <Font cssVariable="--font-mono" />
    <link rel="canonical" href={href(lang, path)} />
    <link rel="alternate" hreflang="en" href={href("en", path)} />
    <link rel="alternate" hreflang="pt-BR" href={href("pt", path)} />
    <link rel="alternate" hreflang="x-default" href={href("en", path)} />
    <link rel="alternate" type="text/plain" href={lang === "en" ? "/llms.txt" : "/pt/llms.txt"} title="llms.txt" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {jsonld && <script type="application/ld+json" set:html={serializeJsonLd(assertPublishable(jsonld))} />}
  </head>
  <body>
    <a href="#main">{t(lang, "skipToContent")}</a>
    <header>
      <nav>
        <a href={localePath(lang, "/")}>{profile.name}</a>
        {nav.map((n) => <a href={localePath(lang, n.path)} aria-current={n.path === path ? "page" : undefined}>{t(lang, n.key)}</a>)}
        <a href={lang === "en" ? "/llms.txt" : "/pt/llms.txt"}>{t(lang, "navAgents")}</a>
        <a href={localePath(other, path)} hreflang={LOCALE[other]} lang={LOCALE[other]}>{t(lang, "otherLang")}</a>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer>
      <h2>{t(lang, "profiles")}</h2>
      <ul>
        {profile.profiles.map((p) => <li><a href={p.url} rel="me">{p.network}: {p.handle}</a></li>)}
      </ul>
    </footer>
  </body>
</html>

<style is:global>
  html {
    font-family: var(--font-sans);
  }
  h1 {
    font-weight: 800;
  }
  code,
  kbd,
  pre,
  samp {
    font-family: var(--font-mono);
  }
</style>
