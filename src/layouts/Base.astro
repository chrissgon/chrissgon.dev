---
// Base layout, design direction A "Estrutura à mostra" as refined in Claude Design (personal-brand
// claude-design/home-full.webp, 2026-09-30): head, Perfect UI, canonical, hreflang, JSON-LD, and the page frame
// (a 1312 px column with 1px borders over the dot grid) holding the header (the domain, the mono navigation, the
// "view as agent" switch on the home page and the EN / PT segmented control), the page's cells and the footer.
// Dark only (2026-09-29).
// Preloads: Inter 400 and 800 (the hero's text, the LCP) are on the first screen; Inter 600 and JetBrains Mono
// load when a rule uses them (ADR-0006).
import "@chrissgon/perfectui/perfectui.css";
import "../styles/site.css";
import { Font } from "astro:assets";
import AgentSwitch from "../components/AgentSwitch.astro";
import Cell from "../components/Cell.astro";
import LangSwitch from "../components/LangSwitch.astro";
import { profile, t, type Lang } from "../data/index.ts";
import { LOCALE, localePath } from "../lib/format.ts";
import { assertPublishable, serializeJsonLd, type jsonLd as JsonLdBuilder } from "../lib/jsonld.ts";
import { siteUrl } from "../lib/site.ts";

interface Props {
  lang: Lang;
  /** The page's path without the locale prefix: "/", "/projects", ... */
  path: string;
  title: string;
  description: string;
  jsonld?: ReturnType<typeof JsonLdBuilder>;
  /** The home page: "view as agent" swaps every region of the body. */
  agentScope?: boolean;
}

const { lang, path, title, description, jsonld, agentScope = false } = Astro.props;
const site = siteUrl(Astro.site);
const href = (l: Lang, p: string) => `${site}${localePath(l, p)}`;
const nav = [
  { key: "navProjects", href: localePath(lang, "/projects"), path: "/projects" },
  { key: "navWriting", href: localePath(lang, "/writing"), path: "/writing" },
  { key: "navLab", href: localePath(lang, "/lab"), path: "/lab" },
  { key: "trajectory", href: `${localePath(lang, "/")}#${lang === "en" ? "trajectory" : "trajetoria"}`, path: "#trajectory" },
  { key: "navAgents", href: `${localePath(lang, "/")}#for-agents`, path: "#for-agents" },
] as const;
---

<!doctype html>
<html lang={LOCALE[lang]} data-pui-mode="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <script is:inline>document.documentElement.classList.add("js");</script>
    <Font cssVariable="--font-sans" preload={[{ weight: "400" }, { weight: "800" }]} />
    <Font cssVariable="--font-mono" />
    <link rel="canonical" href={href(lang, path)} />
    <link rel="alternate" hreflang="en" href={href("en", path)} />
    <link rel="alternate" hreflang="pt-BR" href={href("pt", path)} />
    <link rel="alternate" hreflang="x-default" href={href("en", path)} />
    <link rel="alternate" type="text/plain" href={lang === "en" ? "/llms.txt" : "/pt/llms.txt"} title="llms.txt" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {jsonld && <script type="application/ld+json" set:html={serializeJsonLd(assertPublishable(jsonld))} />}
  </head>
  <body data-agent-scope={agentScope ? "" : undefined}>
    <a class="skip pui-btn pui-solid pui-inverse" href="#main">{t(lang, "skipToContent")}</a>
    <div class="frame">
      <Cell as="header" class="nav">
        <a class="brand" href={localePath(lang, "/")}>{profile.domain}</a>
        <nav class="nav-links">
          {nav.map((n) => <a href={n.href} aria-current={n.path === path ? "page" : undefined}>{t(lang, n.key)}</a>)}
        </nav>
        <div class="nav-end">
          {agentScope && <AgentSwitch lang={lang} id="view-as-agent" compact />}
          <LangSwitch lang={lang} path={path} />
        </div>
      </Cell>
      <main id="main" tabindex="-1">
        <slot />
      </main>
      <Cell as="footer" class="site-footer">
        <h2 class="sr-only">{t(lang, "profiles")}</h2>
        <ul class="profiles">
          {profile.profiles.map((p) => <li><a href={p.url} rel="me">{p.network} {p.handle}</a></li>)}
        </ul>
        <span class="site-name">{profile.domain}</span>
      </Cell>
    </div>
    <script>
      import "../scripts/site.ts";
    </script>
  </body>
</html>
