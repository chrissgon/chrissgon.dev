---
// The generated card of a project without an image (site-content.md 4.1: "a card generated by the site"), in
// the brand's dots: ai-workbench shows its skill count and a bar per prefix read at build; doc-github-workflow a
// pipeline of steps; each project in progress a dot field cut to its own shape. Decorative: the card's text says
// the same, so it is hidden from assistive technology.
import WorkbenchBars from "./WorkbenchBars.astro";
import { readWorkbenchCount } from "../data/index.ts";
import { formatNumber } from "../lib/format.ts";
import type { Lang } from "../data/index.ts";

interface Props {
  id: string;
  lang: Lang;
  /** Short strip (in-progress row of the home page). */
  compact?: boolean;
}
const { id, lang, compact = false } = Astro.props;
const workbench = id === "ai-workbench" ? readWorkbenchCount() : null;
// Shapes of the in-progress cards (design artboard A, Projects).
const SHAPES: Record<string, { size: string; clip: string }> = {
  "perfectui-for-agents": { size: "7px 7px", clip: "polygon(0 100%, 0 55%, 30% 55%, 30% 30%, 62% 30%, 62% 55%, 100% 55%, 100% 100%)" },
  "agent-ready-kit": { size: "10px 10px", clip: "polygon(8% 40%, 30% 40%, 30% 60%, 8% 60%, 8% 40%, 40% 50%, 60% 50%, 60% 20%, 92% 20%, 92% 36%, 60% 36%, 60% 44%, 92% 44%, 92% 60%, 60% 60%, 60% 68%, 92% 68%, 92% 84%, 60% 84%, 60% 50%, 40% 50%)" },
  "social-agent": { size: "14px 7px", clip: "circle(46px at 30% 50%)" },
  "light-site-auditor": { size: "7px 14px", clip: "polygon(0 100%, 0 80%, 25% 62%, 50% 70%, 75% 34%, 100% 20%, 100% 100%)" },
};
const shape = SHAPES[id];
---

<div class:list={["pv", { compact }]} aria-hidden="true">
  {workbench ? (
    <div class="pv-workbench">
      <span class="pv-num">{formatNumber(workbench.skills, lang)}</span>
      <WorkbenchBars count={workbench} height={119} />
    </div>
  ) : id === "doc-github-workflow" ? (
    <div class="pv-pipe">
      <div class="dw dot"></div><div class="line"></div><div class="dw dot"></div><div class="line"></div><div class="dw dot"></div><div class="line dim"></div><div class="dg dot"></div>
    </div>
  ) : (
    <>
      <div class="dg pv-fill" style={shape ? `background-size: ${shape.size}` : undefined}></div>
      {shape && !compact && <div class="dw pv-fill" style={`clip-path: ${shape.clip}`}></div>}
    </>
  )}
</div>

<style>
  .pv {
    position: relative;
    height: 200px;
    border-bottom: 1px solid var(--pui-border);
    background: var(--pui-bg);
    overflow: hidden;
  }
  .pv.compact {
    height: 64px;
  }
  .pv-fill {
    position: absolute;
    inset: 0;
  }
  .pv-workbench {
    position: absolute;
    inset: 24px;
    display: flex;
    align-items: flex-end;
    gap: 16px;
  }
  .pv-workbench :global(.bars) {
    gap: 5px;
  }
  .pv-num {
    font-family: var(--font-mono);
    font-size: 44px;
    font-weight: 600;
    line-height: 1;
  }
  .pv-pipe {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .dot {
    width: 44px;
    height: 44px;
    border-radius: 50%;
  }
  .line {
    width: 40px;
    border-top: 2px dotted var(--pui-text-muted);
  }
  .line.dim {
    border-top-color: var(--pui-border);
  }
</style>
