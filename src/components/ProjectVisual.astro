---
// The generated card of a project without an image (site-content.md 4.1: "a card generated by the site"), in
// the brand's dots: ai-workbench shows its skill count and a bar per prefix read at build; doc-github-workflow a
// pipeline of steps. Other projects without an image show the card's dotted placeholder (ProjectCard.astro).
// Decorative: the card's text says the same, so it is hidden from assistive technology.
import WorkbenchBars from "./WorkbenchBars.astro";
import { readWorkbenchCount } from "../data/index.ts";
import { formatNumber } from "../lib/format.ts";
import type { Lang } from "../data/index.ts";

interface Props {
  id: string;
  lang: Lang;
}
const { id, lang } = Astro.props;
const workbench = id === "ai-workbench" ? readWorkbenchCount() : null;
---

<div class="pv" aria-hidden="true">
  {workbench ? (
    <div class="pv-workbench">
      <span class="pv-num">{formatNumber(workbench.skills, lang)}</span>
      <WorkbenchBars count={workbench} height={133} />
    </div>
  ) : (
    <div class="pv-pipe">
      <div class="dw dot"></div><div class="line"></div><div class="dw dot"></div><div class="line"></div><div class="dw dot"></div><div class="line dim"></div><div class="dg dot"></div>
    </div>
  )}
</div>

<style>
  .pv {
    position: relative;
    height: 216px;
    border-bottom: 1px solid var(--pui-border);
    background: var(--pui-bg);
    overflow: hidden;
  }
  .pv-workbench {
    position: absolute;
    inset: 24px;
    display: flex;
    align-items: flex-end;
    gap: 16px;
  }
  .pv-workbench :global(.bars) {
    gap: 5px;
  }
  .pv-num {
    font-family: var(--font-mono);
    font-size: 44px;
    font-weight: 600;
    line-height: 1;
  }
  .pv-pipe {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .dot {
    width: 44px;
    height: 44px;
    border-radius: 50%;
  }
  .line {
    width: 40px;
    border-top: 2px dotted var(--pui-text-muted);
  }
  .line.dim {
    border-top-color: var(--pui-border);
  }
</style>
