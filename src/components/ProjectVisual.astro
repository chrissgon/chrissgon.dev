---
// The generated cover of a project without an image (site-content.md 4.1: "a card generated by the site"), drawn in
// the brand's dots (.dw white, .dm muted, .dg grey, 7 px apart, src/styles/site.css) and dotted connectors, each one saying what the project does:
//   ai-workbench          its skill count and a bar per prefix, read at build;
//   doc-github-workflow   a pipeline of steps;
//   perfectui-for-agents  an agent's call through MCP becoming a Perfect UI card with its button;
//   agent-ready-kit       one data file fanning out into llms.txt, schema.org and MCP;
//   social-agent          comments answered inside the policy's frame, one held at its edge by the lock;
//   light-site-auditor    a page under the lens, with its three checks: weight, speed on 3G, accessibility.
// No figure besides the ai-workbench count, no text besides names from the cards' own summaries, and no blue (the
// page keeps its one blue element elsewhere). Decorative: the card's text says the same, so it is hidden from
// assistive technology. The ids drawn here are DRAWN_PROJECTS in src/lib/project-visuals.ts.
import WorkbenchBars from "./WorkbenchBars.astro";
import { readWorkbenchCount } from "../data/index.ts";
import { formatNumber } from "../lib/format.ts";
import type { Lang } from "../data/index.ts";

interface Props {
  id: string;
  lang: Lang;
}
const { id, lang } = Astro.props;
const workbench = id === "ai-workbench" ? readWorkbenchCount() : null;
const lock = `<svg class="lock" viewBox="0 0 16 18" width="20" height="22"><path d="M4.5 8V5.5a3.5 3.5 0 0 1 7 0V8" fill="none" stroke="#FFFFFF" stroke-width="2"/><rect x="1" y="8" width="14" height="9" rx="2" fill="#FFFFFF"/></svg>`;
---

<div class="pv" aria-hidden="true" data-visual={id}>
  {workbench ? (
    <div class="pv-workbench">
      <span class="pv-num">{formatNumber(workbench.skills, lang)}</span>
      <WorkbenchBars count={workbench} height={98} />
    </div>
  ) : id === "perfectui-for-agents" ? (
    <div class="pv-row">
      <div class="dw dot"></div>
      <div class="line"></div>
      <span class="label">MCP</span>
      <div class="line"></div>
      <div class="ui">
        <div class="dw" style="width: 56px"></div>
        <div class="dg" style="width: 84px"></div>
        <div class="dg" style="width: 63px"></div>
        <div class="dw btn"></div>
      </div>
    </div>
  ) : id === "agent-ready-kit" ? (
    <div class="pv-row">
      <div class="dw file"></div>
      <div class="line stub"></div>
      <ul class="fan">
        <li><span class="label">llms.txt</span></li>
        <li><span class="label">schema.org</span></li>
        <li><span class="label">MCP</span></li>
      </ul>
    </div>
  ) : id === "social-agent" ? (
    <div class="pv-row">
      <div class="thread">
        <div class="policy"></div>
        <div class="msg"><div class="dm" style="width: 49px"></div><div class="link"></div><div class="dw" style="width: 70px"></div></div>
        <div class="msg"><div class="dm" style="width: 35px"></div><div class="link"></div><div class="dw" style="width: 56px"></div></div>
        <div class="msg"><div class="dm" style="width: 56px"></div><div class="link dim"></div><Fragment set:html={lock} /></div>
        <div class="msg"><div class="dm" style="width: 42px"></div><div class="link"></div><div class="dw" style="width: 63px"></div></div>
      </div>
    </div>
  ) : id === "light-site-auditor" ? (
    <div class="pv-row">
      <div class="page">
        <div class="dg" style="width: 21px"></div>
        <div class="dw" style="height: 28px"></div>
        <div class="dg" style="width: 56px"></div>
        <div class="dg" style="width: 42px"></div>
        <div class="lens"></div>
      </div>
      <ul class="checks">
        <li>
          <svg viewBox="0 0 24 24" width="20" height="20"><circle cx="12" cy="5.5" r="2.5" fill="none" stroke="#FFFFFF" stroke-width="2"/><path d="M7 9h10l2.5 11h-15z" fill="#FFFFFF"/></svg>
          <div class="dg" style="width: 56px"></div>
        </li>
        <li>
          <svg viewBox="0 0 24 24" width="20" height="20"><path d="M4 21v-4M10 21v-8M16 21V9" stroke="#FFFFFF" stroke-width="3"/><path d="M22 21V4" stroke="#374151" stroke-width="3"/></svg>
          <div class="dg" style="width: 70px"></div>
        </li>
        <li>
          <svg viewBox="0 0 24 24" width="20" height="20"><circle cx="12" cy="4.5" r="2.5" fill="#FFFFFF"/><path d="M5 9h14M12 9v5l-3.5 6.5M12 14l3.5 6.5" fill="none" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <div class="dg" style="width: 49px"></div>
        </li>
      </ul>
    </div>
  ) : (
    <div class="pv-row">
      <div class="dw dot"></div><div class="line"></div><div class="dw dot"></div><div class="line"></div><div class="dw dot"></div><div class="line dim"></div><div class="dg dot"></div>
    </div>
  )}
</div>

<style>
  .pv {
    position: relative;
    height: 162px;
    border-bottom: 1px solid var(--pui-border);
    background: var(--pui-bg);
    overflow: hidden;
  }
  .pv-workbench {
    position: absolute;
    inset: 24px;
    display: flex;
    align-items: flex-end;
    gap: 16px;
  }
  .pv-workbench :global(.bars) {
    gap: 5px;
  }
  .pv-num {
    font-family: var(--font-mono);
    font-size: 44px;
    font-weight: 600;
    line-height: 1;
  }
  /* One drawing, centred in the cover; its connectors take up the width it is given. */
  .pv-row {
    position: absolute;
    inset: 0 20px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .pv-row .dg,
  .pv-row .dm,
  .pv-row .dw {
    flex: none;
    height: 7px;
  }
  .dot {
    width: 44px;
    height: 44px !important;
    border-radius: 50%;
  }
  .line {
    flex: 1 1 40px;
    min-width: 12px;
    max-width: 40px;
    border-top: 2px dotted var(--pui-text-muted);
  }
  .line.dim {
    border-top-color: var(--pui-border);
  }
  .label {
    flex: none;
    padding: 3px 7px;
    border: 1px solid var(--pui-border);
    border-radius: 6px;
    background: var(--pui-bg-emphasis);
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.4;
    color: var(--pui-text);
    white-space: nowrap;
  }

  /* perfectui-for-agents: the card the call builds, with its button. */
  .ui {
    flex: none;
    display: flex;
    flex-direction: column;
    gap: 7px;
    width: 112px;
    padding: 12px;
    border: 1px solid var(--pui-border);
    border-radius: 8px;
  }
  .ui .btn {
    width: 49px;
    height: 18px;
    margin-top: 4px;
    border: 1px solid var(--pui-text);
    border-radius: 6px;
    background-position: 1px 1px;
  }

  /* agent-ready-kit: a file, a stub, then a bracket to each output. */
  .file {
    width: 42px;
    height: 56px !important;
    clip-path: polygon(0 0, 66% 0, 100% 25%, 100% 100%, 0 100%);
  }
  .stub {
    max-width: 32px;
  }
  .fan {
    position: relative;
    flex: none;
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0 0 0 20px;
    list-style: none;
  }
  /* The bracket's spine, from the first output's middle to the last one's. */
  .fan::before {
    content: "";
    position: absolute;
    left: 0;
    top: 12px;
    bottom: 12px;
    border-left: 2px dotted var(--pui-text-muted);
  }
  .fan li {
    position: relative;
    display: flex;
    align-items: center;
    height: 24px;
  }
  .fan li::before {
    content: "";
    position: absolute;
    left: -20px;
    width: 16px;
    border-top: 2px dotted var(--pui-text-muted);
  }

  /* social-agent: comment, connector, reply; the replies sit inside the policy's dashed frame, the lock on its edge. */
  .thread {
    position: relative;
    display: grid;
    gap: 14px;
    width: 100%;
    max-width: 260px;
  }
  .policy {
    position: absolute;
    top: -12px;
    bottom: -12px;
    left: 96px;
    right: 0;
    border: 1px dashed var(--pui-border);
    border-radius: 8px;
  }
  .msg {
    display: grid;
    grid-template-columns: 64px 32px 1fr;
    align-items: center;
  }
  .msg .dm,
  .msg .dw {
    height: 14px;
    border-radius: 4px;
  }
  .msg .dm {
    justify-self: end;
  }
  .msg .dw {
    margin-left: 16px;
  }
  .link {
    margin-left: 6px;
    border-top: 2px dotted var(--pui-text-muted);
  }
  .link.dim {
    border-top-color: var(--pui-border);
  }
  .msg :global(.lock) {
    margin-left: -13px;
    padding-inline: 3px;
    background: var(--pui-bg);
  }

  /* light-site-auditor: the page with the lens over it, and its checks. */
  .page {
    position: relative;
    flex: none;
    display: flex;
    flex-direction: column;
    gap: 7px;
    width: 84px;
    padding: 10px;
    border: 1px solid var(--pui-border);
    border-radius: 6px;
  }
  .page .dw {
    width: 100%;
  }
  .lens {
    position: absolute;
    right: -18px;
    bottom: -14px;
    width: 38px;
    height: 38px;
    border: 2px solid var(--pui-text);
    border-radius: 50%;
    background: var(--pui-bg);
  }
  .lens::after {
    content: "";
    position: absolute;
    right: -10px;
    bottom: -4px;
    width: 12px;
    border-top: 3px solid var(--pui-text);
    transform: rotate(45deg);
  }
  .checks {
    flex: none;
    display: grid;
    gap: 10px;
    margin: 0 0 0 40px;
    padding: 0;
    list-style: none;
  }
  .checks li {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .checks svg {
    flex: none;
    box-sizing: content-box;
    padding: 4px;
    border: 1px solid var(--pui-border);
    border-radius: 6px;
    background: var(--pui-bg-emphasis);
  }
</style>
