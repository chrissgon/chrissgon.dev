---
// A project as a Perfect UI card (site-projects.md, refined in Claude Design): the cover on top (the project's
// image, the card the site generates from the data, or a dot pattern generated from the project's id and captioned
// "cover · <name>", src/lib/patterns.ts), the name in mono, the status badge (soft success when ready, soft warn
// in progress), type and stack, the approved text and its links. A project in progress has no link
// (site-content.md 4.2).
import { Image } from "astro:assets";
import ProjectVisual from "./ProjectVisual.astro";
import type { Lang } from "../data/index.ts";
import type { Project } from "../data/schema.ts";
import { statusLabel, typeLabel } from "../lib/format.ts";
import { image } from "../lib/images.ts";
import { coverPattern } from "../lib/patterns.ts";

interface Props {
  project: Project;
  lang: Lang;
}
const { project: p, lang } = Astro.props;
// Projects the site draws a card for (ProjectVisual.astro); the others without an image show their dot pattern.
const drawn = p.id === "ai-workbench" || p.id === "doc-github-workflow";
// How each image sits in the 162 px cover. The two README diagrams have white margins and would lose their top and
// bottom boxes to a crop, so they are shown whole on white; the others are cropped where their title is.
const fit: Record<string, string> = {
  perfectui: "object-position: left 25%",
  "perfectui-doc": "object-position: top",
  goddd: "object-fit: contain; background: #fff",
  "doc-git-patterns": "object-fit: contain; background: #fff",
};
const meta = p.types.map((x) => typeLabel(x, lang)).join(" · ") + (p.stack.length ? ` · ${p.stack.join(", ")}` : "");
---

<article class="pui-card col project" data-project={p.id}>
  {p.image.kind === "file" ? (
    <Image
      src={image(p.image.src)}
      alt=""
      widths={[400, 800]}
      sizes="(max-width: 767px) 100vw, 380px"
      class="card-media"
      style={fit[p.id]}
      loading="lazy"
      decoding="async"
    />
  ) : drawn ? (
    <ProjectVisual id={p.id} lang={lang} />
  ) : (
    <div class="card-media cover-ph" aria-hidden="true"><Fragment set:html={coverPattern(p.id).svg} /><span class="caption">cover · {p.name}</span></div>
  )}
  <div class="pui-card-content grow">
    <div class="card-title-row">
      <h3 class="card-name">{p.name}</h3>
      <span class:list={["pui-badge pui-soft", p.status === "ready" ? "pui-success" : "pui-warn"]}>{statusLabel(p.status, lang)}</span>
    </div>
    <span class="meta">{meta}</span>
    <p class="summary">{p.summary[lang]}</p>
    {p.links.length > 0 && (
      <div class="links">
        {p.links.map((l) => <a href={l.url}>{l.label}</a>)}
      </div>
    )}
  </div>
</article>

<style>
  .project h3 {
    letter-spacing: 0;
    line-height: 1.3;
  }
  .summary {
    font-size: 14px;
    line-height: 1.6;
  }
  .links {
    font-size: 14px;
  }
  .cover-ph {
    position: relative;
    overflow: hidden;
  }
  .cover-ph :global(svg) {
    position: absolute;
    inset: 0;
    display: block;
  }
  .cover-ph .caption {
    position: absolute;
    left: 8px;
    bottom: 6px;
    padding: 2px 4px;
    font-size: 10px;
    background: var(--pui-bg);
  }
</style>
