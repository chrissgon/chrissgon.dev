---
// A project as a Perfect UI card (site-projects.md, refined in Claude Design): the cover on top (the project's
// image, the card the site generates from the data, or a dotted placeholder captioned "cover · <name>"), the name
// in mono, the status badge (soft success when ready, soft warn in progress), type and stack, the approved text
// and its links. A project in progress has no link (site-content.md 4.2).
import { Image } from "astro:assets";
import ProjectVisual from "./ProjectVisual.astro";
import type { Lang } from "../data/index.ts";
import type { Project } from "../data/schema.ts";
import { statusLabel, typeLabel } from "../lib/format.ts";
import { image } from "../lib/images.ts";

interface Props {
  project: Project;
  lang: Lang;
}
const { project: p, lang } = Astro.props;
// Projects the site draws a card for (ProjectVisual.astro); the others without an image show the placeholder.
const drawn = p.id === "ai-workbench" || p.id === "doc-github-workflow";
const meta = p.types.map((x) => typeLabel(x, lang)).join(" · ") + (p.stack.length ? ` · ${p.stack.join(", ")}` : "");
---

<article class="pui-card col project" data-project={p.id}>
  {p.image.kind === "file" ? (
    <Image
      src={image(p.image.src)}
      alt=""
      widths={[400, 800]}
      sizes="(max-width: 767px) 100vw, 380px"
      class="card-media"
      style={p.id === "perfectui-doc" ? "object-position: top" : p.id === "perfectui" ? "object-position: left" : undefined}
      loading="lazy"
      decoding="async"
    />
  ) : drawn ? (
    <ProjectVisual id={p.id} lang={lang} />
  ) : (
    <div class="card-media dots-ph cover-ph" aria-hidden="true"><span class="caption">cover · {p.name}</span></div>
  )}
  <div class="pui-card-content grow">
    <div class="card-title-row">
      <h3 class="card-name">{p.name}</h3>
      <span class:list={["pui-badge pui-soft", p.status === "ready" ? "pui-success" : "pui-warn"]}>{statusLabel(p.status, lang)}</span>
    </div>
    <span class="meta">{meta}</span>
    <p class="summary">{p.summary[lang]}</p>
    {p.links.length > 0 && (
      <div class="links">
        {p.links.map((l) => <a href={l.url}>{l.label}</a>)}
      </div>
    )}
  </div>
</article>

<style>
  .project h3 {
    letter-spacing: 0;
    line-height: 1.3;
  }
  .summary {
    font-size: 14px;
    line-height: 1.6;
  }
  .links {
    font-size: 14px;
  }
  .cover-ph {
    position: relative;
  }
  .cover-ph .caption {
    position: absolute;
    left: 12px;
    bottom: 10px;
    font-size: 10px;
  }
</style>
