---
// "EN / PT" (approved label): the current language is marked, the other one links to the same page in that
// language. The projects page keeps its filters across the switch (FLOW-3): its script adds the query to the
// [data-lang-link] links.
import { t, type Lang } from "../data/index.ts";
import { LOCALE, localePath } from "../lib/format.ts";

interface Props {
  lang: Lang;
  path: string;
}
const { lang, path } = Astro.props;
const codes = t(lang, "langSwitch").split(" / ") as [string, string];
const langs: Lang[] = ["en", "pt"];
---

<span class="lang">
  {langs.map((l, i) => (
    <>
      {i > 0 && " / "}
      {l === lang ? (
        <span aria-current="true">{codes[i]}</span>
      ) : (
        <a href={localePath(l, path)} hreflang={LOCALE[l]} lang={LOCALE[l]} data-lang-link>{codes[i]}</a>
      )}
    </>
  ))}
</span>
