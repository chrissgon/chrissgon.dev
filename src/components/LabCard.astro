---
// A lab experiment as a column of the home page's lab row (Claude Design): its dot visual in a bordered box, the
// name in mono with the date, the approved description and the source button. The visual and the name open the
// experiment at /lab#<slug> (FLOW-7).
import LabVisual from "./LabVisual.astro";
import { t, type Lang, type lab } from "../data/index.ts";
import { localePath } from "../lib/format.ts";

interface Props {
  item: (typeof lab)[number];
  lang: Lang;
}
const { item: x, lang } = Astro.props;
---

<article class="lab-card">
  <a class="lab-open" href={`${localePath(lang, "/lab")}#${x.id}`}>
    <span class="lab-visual"><LabVisual id={x.id} height={120} /></span>
    <span class="lab-row">
      <span class="lab-name">{x.id}</span>
      <time class="meta" datetime={x.date}>{x.date}</time>
    </span>
    <span class="lab-desc">{x.description[lang]}</span>
  </a>
  {x.source && (
    <div>
      <a class="pui-btn pui-outline pui-surface mono" href={x.source}>{t(lang, "source")}</a>
    </div>
  )}
</article>

<style>
  .lab-card {
    display: flex;
    flex-direction: column;
    gap: 16px;
    height: 100%;
  }
  .lab-open {
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
    color: var(--pui-text);
    text-decoration: none;
  }
  .lab-visual {
    display: block;
    margin-bottom: 6px;
    border: 1px solid var(--pui-border);
    border-radius: calc(var(--pui-radius) * 1.5);
    overflow: hidden;
  }
  .lab-visual :global(.lv) {
    border-bottom: none;
  }
  .lab-open:hover .lab-name {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .lab-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px;
  }
  .lab-name {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
  }
  .lab-row .meta {
    font-size: 10px;
  }
  .lab-desc {
    font-size: 13px;
    line-height: 1.5;
    color: var(--pui-text-muted);
  }
  .pui-btn {
    font-size: 12px;
  }
</style>
