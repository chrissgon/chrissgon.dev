---
// A post as a Perfect UI card linking to LinkedIn (site-writing.md): the post's own cover, cropped to one
// ratio from the centre, as the card's largest element; the title in the post's language; the date; the
// language badges; comments and reactions read from the post's public page. The cover's alt is empty because
// the title is the link's text right below it.
import { Image } from "astro:assets";
import { postTitle, type Lang, type posts } from "../data/index.ts";
import { countLabel, LOCALE } from "../lib/format.ts";
import { image } from "../lib/images.ts";

interface Props {
  post: (typeof posts)[number];
  lang: Lang;
  /** Show the ISO date inside the card (home page); the writing page shows it as the cell's tag. */
  date?: boolean;
  eager?: boolean;
}
const { post: p, lang, date = true, eager = false } = Astro.props;
const titleLang = p.title[lang] ? undefined : LOCALE[p.lang[0]!];
---

<a class="pui-card card-link post-card" href={p.url}>
  <Image
    src={image(p.cover)}
    alt=""
    widths={[320, 640]}
    sizes="(max-width: 767px) 100vw, 290px"
    class="cover"
    loading={eager ? "eager" : "lazy"}
    decoding="async"
  />
  <span class="pui-card-content">
    {date && <time class="meta" datetime={p.date}>{p.date}</time>}
    <strong class="title" lang={titleLang}>{postTitle(p, lang)}</strong>
    <span class="badges">
      {p.lang.map((l) => <span class="pui-badge pui-outline pui-surface">{l.toUpperCase()}</span>)}
      {p.stats && (
        <span class="meta">{countLabel(p.stats.comments, lang, "comment", "comments")} · {countLabel(p.stats.reactions, lang, "reaction", "reactions")}</span>
      )}
    </span>
  </span>
</a>

<style>
  .post-card .cover {
    display: block;
    width: 100%;
    height: 328px;
    object-fit: cover;
    object-position: center;
    border-bottom: 1px solid var(--pui-border);
    background: var(--pui-bg-emphasis);
    transition: opacity 0.15s;
  }
  .post-card:hover .cover {
    opacity: 0.85;
  }
  .post-card .pui-card-content {
    gap: 10px;
  }
  .title {
    font-size: 16px;
    font-weight: 600;
    line-height: 1.35;
  }
  .badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
  }
  .badges .meta {
    margin-inline-start: 6px;
  }
  @media (max-width: 767px) {
    .post-card .cover {
      height: 300px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .post-card .cover {
      transition: none;
    }
  }
</style>
