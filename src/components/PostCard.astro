---
// A post as a Perfect UI card linking to LinkedIn (site-writing.md, refined in Claude Design): the post's own
// cover as a 4:5 portrait (owner, 2026-09-30), cropped at build around the post's `coverFocus`; the date
// (optional); the language badges with reactions and comments read from the post's public page; the title in the
// post's language. `compact`: the home page's row, with a smaller title. The cover's alt is empty because the
// title is the link's text right below it.
import { Image } from "astro:assets";
import { postTitle, type Lang, type posts } from "../data/index.ts";
import { coverSize, coverWidths, largestCrop } from "../lib/covers.ts";
import { countLabel, LOCALE } from "../lib/format.ts";
import { image } from "../lib/images.ts";

interface Props {
  post: (typeof posts)[number];
  lang: Lang;
  /** Show the ISO date inside the card (home page); the writing page shows it as the cell's tag. */
  date?: boolean;
  /** Load the cover at once with high priority: the page's first card. */
  eager?: boolean;
  compact?: boolean;
  /** The cover's `sizes`: how wide the card is drawn in the caller's layout. */
  sizes: string;
}
const { post: p, lang, date = true, eager = false, compact = false, sizes } = Astro.props;
const titleLang = p.title[lang] ? undefined : LOCALE[p.lang[0]!];
const src = image(p.cover);
// Never ask for more than the largest 4:5 crop the source holds (src/lib/covers.ts). The fallback `src` is the
// smallest file; browsers pick from the srcset.
const widths = coverWidths(largestCrop(src).width);
const size = coverSize(widths[0]!);
---

<a class:list={["pui-card card-link post-card", { compact }]} href={p.url}>
  <Image
    src={src}
    alt=""
    width={size.width}
    height={size.height}
    widths={widths}
    sizes={sizes}
    fit="cover"
    position={p.coverFocus ?? "center"}
    class="cover"
    loading={eager ? "eager" : "lazy"}
    fetchpriority={eager ? "high" : "auto"}
    decoding="async"
  />
  <span class="pui-card-content">
    {date && <time class="meta" datetime={p.date}>{p.date}</time>}
    <span class="badges">
      {p.lang.map((l) => <span class="pui-badge pui-outline pui-surface mono">{l.toUpperCase()}</span>)}
      {p.stats && (
        <span class="meta">{countLabel(p.stats.reactions, lang, "reaction", "reactions")} · {countLabel(p.stats.comments, lang, "comment", "comments")}</span>
      )}
    </span>
    <strong class="title" lang={titleLang}>{postTitle(p, lang)}</strong>
  </span>
</a>

<style>
  .post-card .cover {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-bottom: 1px solid var(--pui-border);
    background: var(--pui-bg-emphasis);
    transition: opacity 0.15s;
  }
  .post-card:hover .cover {
    opacity: 0.85;
  }
  .post-card .pui-card-content {
    gap: 10px;
  }
  .compact .pui-card-content {
    align-content: start;
    min-height: 124px;
  }
  .compact .title {
    font-size: 14px;
  }
  .title {
    font-size: 16px;
    font-weight: 600;
    line-height: 1.35;
  }
  .badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
  }
  .badges .pui-badge {
    padding: 1px 5px;
    font-size: 10px;
  }
  .badges .meta {
    margin-inline-start: 4px;
    font-size: 11px;
  }
  @media (prefers-reduced-motion: reduce) {
    .post-card .cover {
      transition: none;
    }
  }
</style>

<style is:global>
  /* The posts' focus effect (owner, 2026-10-01), CSS only: with the pointer on a card, or keyboard focus on one,
     the other cards of its list go to opacity 0.3 and that card stays whole; with the pointer off the cards
     (outside the list or between two cards) every card is whole. No card grows or moves. The lists are the home
     page's row (.posts) and the writing page's sheet (.sheet); global, because the list belongs to the page, not
     to this component. A browser without :has() dims nothing. scripts/check-layout.ts hovers and focuses every
     card at every width. */
  .post-card {
    transition:
      border-color 0.15s,
      opacity 0.2s var(--ease);
  }
  :is(.posts, .sheet):has(.post-card:focus-visible) .post-card:not(:focus-visible) {
    opacity: 0.3;
  }
  /* A mouse or a pen only: a touch screen has no hover to leave. */
  @media (hover: hover) and (pointer: fine) {
    :is(.posts, .sheet):has(.post-card:hover) .post-card:not(:hover, :focus-visible) {
      opacity: 0.3;
    }
  }
  /* Reduced motion keeps the dimming and drops the transition. */
  @media (prefers-reduced-motion: reduce) {
    .post-card {
      transition: none;
    }
  }
</style>
