---
// A post as a Perfect UI card linking to LinkedIn (site-writing.md, refined in Claude Design): the post's own
// cover as a 4:5 portrait (owner, 2026-09-30), cropped at build around the post's `coverFocus`; the date
// (optional); the language badges with reactions and comments read from the post's public page; the title in the
// post's language. `compact`: the home page's row, with a smaller title. The cover's alt is empty because the
// title is the link's text right below it.
import { Image } from "astro:assets";
import { postTitle, type Lang, type posts } from "../data/index.ts";
import { coverSize, coverWidths, largestCrop } from "../lib/covers.ts";
import { countLabel, LOCALE } from "../lib/format.ts";
import { image } from "../lib/images.ts";

interface Props {
  post: (typeof posts)[number];
  lang: Lang;
  /** Show the ISO date inside the card (home page); the writing page shows it as the cell's tag. */
  date?: boolean;
  /** Load the cover at once with high priority: the page's first card. */
  eager?: boolean;
  compact?: boolean;
  /** The cover's `sizes`: how wide the card is drawn in the caller's layout. */
  sizes: string;
}
const { post: p, lang, date = true, eager = false, compact = false, sizes } = Astro.props;
const titleLang = p.title[lang] ? undefined : LOCALE[p.lang[0]!];
const src = image(p.cover);
// Never ask for more than the largest 4:5 crop the source holds (src/lib/covers.ts). The fallback `src` is the
// smallest file; browsers pick from the srcset.
const widths = coverWidths(largestCrop(src).width);
const size = coverSize(widths[0]!);
---

<a class:list={["pui-card card-link post-card", { compact }]} href={p.url}>
  <Image
    src={src}
    alt=""
    width={size.width}
    height={size.height}
    widths={widths}
    sizes={sizes}
    fit="cover"
    position={p.coverFocus ?? "center"}
    class="cover"
    loading={eager ? "eager" : "lazy"}
    fetchpriority={eager ? "high" : "auto"}
    decoding="async"
  />
  <span class="pui-card-content">
    {date && <time class="meta" datetime={p.date}>{p.date}</time>}
    <span class="badges">
      {p.lang.map((l) => <span class="pui-badge pui-outline pui-surface mono">{l.toUpperCase()}</span>)}
      {p.stats && (
        <span class="meta">{countLabel(p.stats.reactions, lang, "reaction", "reactions")} · {countLabel(p.stats.comments, lang, "comment", "comments")}</span>
      )}
    </span>
    <strong class="title" lang={titleLang}>{postTitle(p, lang)}</strong>
  </span>
  {/* The hover effect's corner marks and its scan line (styles below); nothing to read. */}
  <span class="hud" aria-hidden="true"><i></i><b></b></span>
</a>

<style>
  .post-card .cover {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-bottom: 1px solid var(--pui-border);
    background: var(--pui-bg-emphasis);
  }
  .post-card .pui-card-content {
    gap: 10px;
  }
  .compact .pui-card-content {
    align-content: start;
    min-height: 124px;
  }
  .compact .title {
    font-size: 14px;
  }
  .title {
    font-size: 16px;
    font-weight: 600;
    line-height: 1.35;
  }
  .badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
  }
  .badges .pui-badge {
    padding: 1px 5px;
    font-size: 10px;
  }
  .badges .meta {
    margin-inline-start: 4px;
    font-size: 11px;
  }
</style>

<style is:global>
  /* The posts' hover effect (owner, 2026-10-02), CSS only: the card under the pointer, or with keyboard focus,
     is framed the way a vision model marks what it has found. Four corner marks close in on the card and stay
     while it is hovered, and one line scans it once from top to bottom. No card dims, grows or moves, and the
     card's border does not change. Global, because the cards of the home page's row (.posts) and of the writing
     page's sheet (.sheet) are redrawn by neither; the marks sit inside the card, so the row that scrolls
     sideways below 1024 px cuts nothing. Colours are the text token only (one blue element per viewport).
     scripts/check-layout.ts hovers and focuses every card at every width. */
  .post-card {
    position: relative;
  }
  .post-card .hud {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  /* The four marks are one bordered box of which only the 12 px corners are kept (the polygon walks the four
     corner squares, joined along the box's edges). It waits 8 px further in and closes out to the corners. */
  .post-card .hud i {
    position: absolute;
    inset: 16px;
    border: 1px solid var(--pui-text);
    opacity: 0;
    clip-path: polygon(0 0, 12px 0, 12px 12px, 0 12px, 0 calc(100% - 12px), 12px calc(100% - 12px), 12px 100%, calc(100% - 12px) 100%, calc(100% - 12px) calc(100% - 12px), 100% calc(100% - 12px), 100% 12px, calc(100% - 12px) 12px, calc(100% - 12px) 0);
    transition:
      opacity 0.15s,
      inset 0.25s var(--ease);
  }
  .post-card .hud b {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--pui-text);
    opacity: 0;
  }
  .post-card:focus-visible .hud i {
    inset: 8px;
    opacity: 1;
  }
  .post-card:focus-visible .hud b {
    animation: post-scan 0.7s linear;
  }
  /* A mouse or a pen only: a touch screen has no hover to leave. */
  @media (hover: hover) and (pointer: fine) {
    .post-card:hover .hud i {
      inset: 8px;
      opacity: 1;
    }
    .post-card:hover .hud b {
      animation: post-scan 0.7s linear;
    }
  }
  @keyframes post-scan {
    from { top: 0; opacity: 0.6; }
    90% { opacity: 0.6; }
    to { top: 100%; opacity: 0; }
  }
  /* Reduced motion keeps the corner marks, in place at once, and drops the scan. */
  @media (prefers-reduced-motion: reduce) {
    .post-card .hud i {
      transition: none;
    }
    .post-card .hud b {
      animation: none !important;
    }
  }
</style>
