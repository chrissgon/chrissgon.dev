---
// view-as-agent (lab experiment and the switch in every page's header): a real Perfect UI switch. When it is on,
// every region of its scope (the nearest [data-agent-scope]) shows its llms.txt reading instead of its human
// form. The swap is pure CSS (:has), so it works without JavaScript; the rules live in src/styles/site.css, in
// short (a scope inside another, the lab's experiment inside the page, only reacts to its own switch):
//   [data-agent-scope]:has(.agent-toggle:checked) .agent-text { display: block }
//   [data-agent-scope]:has(.agent-toggle:checked) .human { display: none }
// Its size comes from Perfect UI's own --pui-font-size, never a transform. `compact`: the header's small form.
import { t, type Lang } from "../data/index.ts";

interface Props {
  lang: Lang;
  id: string;
  compact?: boolean;
}
const { lang, id, compact = false } = Astro.props;
---

<label class:list={["switch-label", { compact }]} for={id}><input type="checkbox" class="pui-switch agent-toggle" id={id} /><span>{t(lang, "viewAsAgent")}</span></label>
