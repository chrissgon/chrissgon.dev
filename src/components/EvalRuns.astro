---
// workbench-evals: ai-workbench skills scored with and without the skill, on a floor and a strong model, in a
// Perfect UI table. Only runs checked in site-content.md are shown (src/data/lab.ts); a skill without a
// published run is not listed.
import { lab, t, type Lang } from "../data/index.ts";
import { LOCALE } from "../lib/format.ts";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const runs = lab.find((x) => x.id === "workbench-evals")?.runs ?? [];
// Scores as the source writes them: 1.0, 0.75, 0.812 (one to three decimals).
const score = (v: number) => v.toLocaleString(LOCALE[lang], { minimumFractionDigits: 1, maximumFractionDigits: 3 });
---

<div class="pui-card evals">
  <table class="pui-table">
    <thead>
      <tr>
        <th scope="col">{t(lang, "evalSkill")}</th>
        <th scope="col">{t(lang, "evalModel")}</th>
        <th scope="col">{t(lang, "evalRun")}</th>
        <th scope="col">{t(lang, "evalWith")}</th>
        <th scope="col">{t(lang, "evalWithout")}</th>
      </tr>
    </thead>
    <tbody>
      {runs.map((r) => (
        <tr>
          <td>{r.skill}</td>
          <td>{r.model} ({r.role[lang]})</td>
          <td>{r.iteration}</td>
          <td>{score(r.withSkill)}</td>
          <td>{score(r.withoutSkill)}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .evals {
    overflow-x: auto;
  }
  .evals table {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }
</style>
