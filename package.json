{
  "name": "chrissgon.dev",
  "version": "0.1.0",
  "private": true,
  "description": "Christopher Gonçalves's personal site: static Astro pages, llms.txt and schema.org data from one typed data module.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "data:npm": "tsx scripts/fetch-npm.ts",
    "data:workbench": "tsx scripts/fetch-workbench.ts",
    "check:data": "tsx scripts/check-sensitive.ts --data",
    "check:images": "tsx scripts/check-images.ts",
    "check:dist": "tsx scripts/check-sensitive.ts --dist && tsx scripts/check-dist.ts",
    "build": "npm run data:npm && npm run data:workbench && npm run check:data && npm run check:images && astro build && npm run check:dist",
    "preview": "astro preview",
    "typecheck": "astro check && tsc --noEmit",
    "test": "vitest run",
    "lighthouse": "tsx scripts/lighthouse.ts",
    "secrets": "python3 scripts/secret-scan/secret_scan.py",
    "check:portrait": "tsx scripts/check-portrait.ts",
    "check:layout": "tsx scripts/check-layout.ts",
    "check:griddots": "tsx scripts/check-griddots.ts",
    "og:image": "tsx scripts/og-image.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@chrissgon/perfectui": "1.0.0",
    "@modelcontextprotocol/sdk": "1.31.0",
    "astro": "7.3.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@netlify/functions": "6.0.0",
    "@types/node": "22.20.4",
    "lighthouse": "13.5.0",
    "playwright": "1.63.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}
