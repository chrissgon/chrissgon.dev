#!/usr/bin/env bash
# Pre-commit checks: the same as the CI workflow (.github/workflows/checks.yml).
# Installed by husky on `npm install` (package.json: "prepare": "husky"); nothing to enable by hand.
# 1. The secret scan of the working tree (scripts/secret-scan/secret_scan.py).
# 2. Types, tests and the build, which includes the sensitive-topics check of the data and of dist/
#    (with docs/private-terms.txt when that local file exists).
# Skipping the hook (git commit --no-verify) is the user's decision, never an agent's.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
python3 scripts/secret-scan/secret_scan.py || { echo "pre-commit: a secret or credential file was found (listed above). Remove it; a planted test value is allowed by a line in .secret-scan-allow with its reason." >&2; exit 1; }
npm run --silent typecheck
npm test --silent
npm run --silent build
